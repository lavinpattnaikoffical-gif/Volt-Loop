# ==============================================================================
# VOLTLOOP — PRIMARY SUPABASE & AI CONFIGURATION
# ==============================================================================

# 1. Supabase (Primary Database, Auth, and Storage)
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google OAuth (Configured inside Supabase Auth -> Providers -> Google)
# Redirect URI to configure in Google Cloud Console:
# https://<your-project-id>.supabase.co/auth/v1/callback

# 3. Amazon Bedrock (Optional AI Engine)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AI_PROVIDER=mock # Options: 'mock' | 'bedrock'
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
